# Cấu hình Zalo Mini App & Zalo Official Account (OA) Backend
PORT=5000

# 1. App Secret của Mini App (Lấy tại Zalo Developer Console -> Ứng dụng của bạn -> Cài đặt)
ZALO_APP_SECRET=your_mini_app_secret_here

# 2. Access Token của Zalo Official Account (Lấy tại https://developers.zalo.me/tools/explorer hoặc qua OA API)
ZALO_OA_ACCESS_TOKEN=your_zalo_oa_access_token_here

# 3. User ID Zalo của Admin / Trưởng Văn phòng (Nhận thông báo khi có khách đăng ký)
ADMIN_ZALO_USER_ID=your_admin_zalo_user_id_here
